# ============================================================
# AI CAREER COPILOT - BACKEND ENVIRONMENT VARIABLES
# ============================================================

# Django Core Settings
SECRET_KEY=your-production-django-secret-key-here
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production
ALLOWED_HOSTS=.onrender.com,your-custom-domain.com,localhost,127.0.0.1

# Security & CORS Setup (Set to your Vercel frontend production URL)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Database Settings (Render PostgreSQL automatically supplies DATABASE_URL)
DATABASE_URL=postgres://user:password@host:5432/career_copilot_db
# DB_NAME=career_copilot_db
# DB_USER=himanshukumar
# DB_PASSWORD=himanshu123
# DB_HOST=postgres
# DB_PORT=5432

# Redis Cache (Optional for single web instance, falls back to LocMemCache)
# REDIS_URL=redis://redis:6379/1

# AI / LangChain / Groq Provider
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# Cloudinary Media Storage (Optional, user photos fall back to local if unset)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OAuth & Email Settings
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=True
